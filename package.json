{
  "name": "arcadia",
  "version": "1.0.0",
  "private": true,
  "description": "Arcadia — Teams-native AI operations layer for Microsoft 365",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:scheduled": "wrangler dev --test-scheduled",
    "db:init": "wrangler d1 execute arcadia-db --file=schema/d1-init.sql",
    "db:init:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-init.sql",
    "db:migrate:phase2": "wrangler d1 execute arcadia-db --file=schema/d1-phase2.sql",
    "db:migrate:phase2:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase2.sql",
    "db:migrate:phase3": "wrangler d1 execute arcadia-db --file=schema/d1-phase3.sql",
    "db:migrate:phase3:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase3.sql",
    "db:migrate:phase4": "wrangler d1 execute arcadia-db --file=schema/d1-phase4.sql",
    "db:migrate:phase4:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase4.sql",
    "db:migrate:phase5": "wrangler d1 execute arcadia-db --file=schema/d1-phase5.sql",
    "db:migrate:phase5:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase5.sql",
    "db:migrate:phase6": "wrangler d1 execute arcadia-db --file=schema/d1-phase6.sql",
    "db:migrate:phase6:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase6.sql",
    "db:migrate:phase7": "wrangler d1 execute arcadia-db --file=schema/d1-phase7-webapp.sql",
    "db:migrate:phase7:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase7-webapp.sql",
    "db:migrate:phase8": "wrangler d1 execute arcadia-db --file=schema/d1-phase8-teams-auth.sql",
    "db:migrate:phase8:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase8-teams-auth.sql",
    "db:migrate:phase9": "wrangler d1 execute arcadia-db --file=schema/d1-phase9.sql",
    "db:migrate:phase9:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase9.sql",
    "db:migrate:phase10": "wrangler d1 execute arcadia-db --file=schema/d1-phase10.sql",
    "db:migrate:phase10:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase10.sql",
    "db:migrate:phase11": "wrangler d1 execute arcadia-db --file=schema/d1-phase11.sql",
    "db:migrate:phase11:remote": "wrangler d1 execute arcadia-db --remote --file=schema/d1-phase11.sql",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:remote": "tsx scripts/migrate.ts --remote",
    "db:backfill-acl": "tsx scripts/backfill-acl.ts",
    "db:backfill-acl:remote": "tsx scripts/backfill-acl.ts --remote",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run type-check && npm run test",
    "verify:parity": "tsx scripts/verify-parity.ts"
  },
  "dependencies": {
    "botbuilder": "^4.23.1",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20260426.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.101.0"
  }
}
