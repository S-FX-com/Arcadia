{
  "name": "arcadia",
  "version": "4.0.0",
  "private": true,
  "description": "Arcadia — S-FX Operations Intelligence Layer (v4, Cloudflare agents SDK)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "bash scripts/setup.sh",
    "db:apply": "wrangler d1 execute arcadia-ops --file=src/schema/d1.sql",
    "db:apply:remote": "wrangler d1 execute arcadia-ops --remote --file=src/schema/d1.sql",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration --passWithNoTests",
    "ci": "npm run type-check && npm run test && npm run test:integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@cloudflare/puppeteer": "^1.3.0",
    "agents": "0.20.1",
    "jose": "^5.9.6",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
