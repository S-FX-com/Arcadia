{
  "name": "arcadia",
  "version": "2.0.0",
  "private": true,
  "description": "Arcadia — Microsoft 365 AI operations layer (v2, on Microsoft 365 Agents SDK)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:scheduled": "wrangler dev --test-scheduled",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:remote": "tsx scripts/migrate.ts --remote",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run type-check && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@microsoft/agents-bot-activity": "^0.4.0",
    "@microsoft/agents-bot-hosting": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20260426.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^3.101.0"
  }
}
