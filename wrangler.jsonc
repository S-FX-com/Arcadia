{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcadia",
  "main": "src/index.ts",
  // >= 2026-03-15 so ctx.id.name is populated inside alarm handlers — the
  // agents SDK examples pin 2026-06-11 for the same reason.
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // Every agent is a SQLite-backed Durable Object (§2). Binding name matches
  // class name so the SDK's workflow/agent auto-detection works.
  "durable_objects": {
    "bindings": [
      { "name": "Arcadia", "class_name": "Arcadia" },
      { "name": "Hermes", "class_name": "Hermes" },
      { "name": "Radar", "class_name": "Radar" },
      { "name": "Ledger", "class_name": "Ledger" },
      { "name": "Dispatcher", "class_name": "Dispatcher" },
      { "name": "MemoryProfile", "class_name": "MemoryProfile" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Arcadia", "Hermes", "Radar", "Ledger", "MemoryProfile"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Dispatcher"]
    }
  ],

  // Durable multi-step with native human-in-the-loop (§2). Instances are
  // started via agent.runWorkflow(), never env.BINDING.create() directly.
  "workflows": [
    { "name": "hermes-publish", "binding": "PUBLISH_WORKFLOW", "class_name": "PublishWorkflow" },
    { "name": "doctrine-ratify", "binding": "RATIFY_WORKFLOW", "class_name": "RatifyWorkflow" },
    { "name": "site-plan", "binding": "SITEPLAN_WORKFLOW", "class_name": "SitePlanWorkflow" },
    { "name": "doctrine-seed", "binding": "SEED_WORKFLOW", "class_name": "SeedWorkflow" }
  ],

  // scripts/setup.sh creates these resources and fills in the ids.
  "d1_databases": [
    { "binding": "DB", "database_name": "arcadia-ops", "database_id": "fde20e63-e2f2-432a-aceb-b04830343415" }
  ],
  "kv_namespaces": [{ "binding": "CONTROL", "id": "1240e8d7f8b04e86844b5a0e68320651" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "arcadia-artifacts" }],
  "vectorize": [
    { "binding": "VEC_DOCTRINE_CANONICAL", "index_name": "arcadia-doctrine-canonical" },
    { "binding": "VEC_DOCTRINE_STAGING", "index_name": "arcadia-doctrine-staging" },
    { "binding": "VEC_EPISODIC", "index_name": "arcadia-episodic" },
    { "binding": "VEC_PUBLISHED_LOG", "index_name": "arcadia-published-log" }
  ],
  "queues": {
    "producers": [{ "binding": "VECTORIZE_QUEUE", "queue": "arcadia-vectorize" }],
    "consumers": [
      {
        "queue": "arcadia-vectorize",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "arcadia-vectorize-dlq"
      }
    ]
  },
  // Workers AI is the default reasoning provider (§6) as well as embeddings.
  "ai": { "binding": "AI" },

  // Browser Rendering: the 390px mobile certification verifier. Requires a
  // paid plan; the verifier reports "unverifiable" if this is removed.
  "browser": { "binding": "BROWSER" },

  // Bootstrap only: wakes the agents daily so SDK-persisted schedules exist
  // after fresh deploys. Real scheduling is agents SDK scheduling (§2).
  "triggers": { "crons": ["0 6 * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "CF_ACCOUNT_ID": "df01126c18116d8254d054785909a59e",
    "AI_GATEWAY_ID": "arcadia",
    "WP_BASE_URL": "https://www.s-fx.com",
    "WP_USERNAME": "sfxdotcom",
    "PUBLISH_TZ": "America/New_York",
    "PUBLISH_WINDOW": "09:00-17:00",
    // UTC — ≈ 9-10am America/New_York, weekdays.
    "HERMES_CRON": "0 14 * * 1-5",
    // Comma-separated emails allowed to operate the kill switch — the spec
    // names Shane, Diego, and Vicky (§4). Verify these addresses before deploy.
    "KILL_SWITCH_OPERATORS": "shane@s-fx.com,diego@s-fx.com,vicky@s-fx.com",
    // Microsoft Entra — one app registration for both staff sign-in (the only
    // authentication path) and Graph. Tenant and client id are public
    // identifiers, so they live here; GRAPH_CLIENT_SECRET is a secret. The
    // redirect URI registered in Entra must be
    // https://arcadia.s-fx.com/auth/callback (add http://localhost:8787/auth/callback
    // for `wrangler dev`).
    "GRAPH_TENANT_ID": "76d9eabb-931c-452b-9e08-058b058b6581",
    "GRAPH_CLIENT_ID": "f929e2c2-6757-42bf-8147-3493d5de4daa",
    // Day-7 founder digest recipient (§4 M1).
    "FOUNDER_EMAIL": "shane@s-fx.com",
    // Escalation email sender. Unset EMAIL_API_KEY = accountability board only.
    "EMAIL_FROM": "Arcadia <arcadia@s-fx.com>",
    // Optional — SureRank meta is skipped (and the skip surfaced to the
    // approver) when unset. To enable, read the real keys off a live
    // tutorial post (§9.6), never guess:
    // curl "https://www.s-fx.com/wp-json/wp/v2/tutorials/<id>?_fields=meta"
    "SURERANK_META_KEYS": ""
  }
  // Secrets (wrangler secret put): GRAPH_CLIENT_SECRET, SSO_SESSION_SECRET,
  // WP_APP_PASSWORD, and optionally ANTHROPIC_API_KEY, AI_GATEWAY_TOKEN
  // (authenticated gateway), SERPAPI_KEY.
}
