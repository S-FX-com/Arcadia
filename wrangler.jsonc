{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcadia",
  "main": "src/index.ts",
  // >= 2026-03-15 so ctx.id.name is populated inside alarm handlers — the
  // agents SDK examples pin 2026-06-11 for the same reason.
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // SQLite-backed Durable Objects. Arcadia is the scheduler agent (the daily
  // directory sync and shift-pattern post); MemoryProfile is the hybrid
  // retrieval engine that Phase 9 adopts or deletes. Binding name matches
  // class name, as the agents SDK expects.
  "durable_objects": {
    "bindings": [
      { "name": "Arcadia", "class_name": "Arcadia" },
      { "name": "MemoryProfile", "class_name": "MemoryProfile" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Arcadia", "Hermes", "Radar", "Ledger", "MemoryProfile"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Dispatcher"]
    },
    {
      // Content publishing was dropped. A class cannot simply disappear from
      // the script — the deploy fails until a migration says it is gone, and
      // this one discards the Hermes DO's stored state with it.
      "tag": "v3",
      "deleted_classes": ["Hermes"]
    },
    {
      // v6 Phase 1: the accountability instruments are gone. Deploying this
      // migration permanently destroys the stored state of every Radar,
      // Ledger and Dispatcher instance. scripts/export-d1.sh backs up D1
      // only, not Durable Object storage. See docs/teardown-v5.md.
      "tag": "v4",
      "deleted_classes": ["Radar", "Ledger", "Dispatcher"]
    }
  ],

  // scripts/setup.sh creates these resources and fills in the ids.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcadia-ops",
      "database_id": "fde20e63-e2f2-432a-aceb-b04830343415",
      // Schema lives in numbered files under migrations/, applied with
      // `wrangler d1 migrations apply`. See migrations/README.md.
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONTROL", "id": "1240e8d7f8b04e86844b5a0e68320651" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "arcadia-artifacts" }],
  // Vectorize, the queue and its DLQ serve MemoryProfile only. Phase 9
  // decides whether they stay.
  "vectorize": [
    { "binding": "VEC_DOCTRINE_CANONICAL", "index_name": "arcadia-doctrine-canonical" },
    { "binding": "VEC_DOCTRINE_STAGING", "index_name": "arcadia-doctrine-staging" },
    { "binding": "VEC_EPISODIC", "index_name": "arcadia-episodic" }
  ],
  "queues": {
    "producers": [{ "binding": "VECTORIZE_QUEUE", "queue": "arcadia-vectorize" }],
    "consumers": [
      {
        "queue": "arcadia-vectorize",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "arcadia-vectorize-dlq"
      }
    ]
  },
  // Workers AI is the default reasoning provider as well as embeddings.
  "ai": { "binding": "AI" },

  // Bootstrap only: wakes the Arcadia scheduler daily so its SDK-persisted
  // schedules exist after fresh deploys. Real scheduling lives in the agent.
  "triggers": { "crons": ["0 6 * * *"] },

  "observability": { "enabled": true },

  "vars": {
    "CF_ACCOUNT_ID": "df01126c18116d8254d054785909a59e",
    "AI_GATEWAY_ID": "arcadia",
    // Microsoft Entra — one app registration for both staff sign-in (the only
    // authentication path) and Graph. Tenant and client id are public
    // identifiers, so they live here; GRAPH_CLIENT_SECRET is a secret. The
    // redirect URI registered in Entra must be
    // https://arcadia.s-fx.com/auth/callback (add http://localhost:8787/auth/callback
    // for `wrangler dev`).
    "GRAPH_TENANT_ID": "76d9eabb-931c-452b-9e08-058b058b6581",
    "GRAPH_CLIENT_ID": "f929e2c2-6757-42bf-8147-3493d5de4daa"
  }
  // Secrets (wrangler secret put): GRAPH_CLIENT_SECRET, SSO_SESSION_SECRET,
  // and optionally ANTHROPIC_API_KEY, AI_GATEWAY_TOKEN (authenticated
  // gateway).
}
