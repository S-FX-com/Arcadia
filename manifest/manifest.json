{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "REPLACE_WITH_YOUR_TEAMS_APP_ID",
  "developer": {
    "name": "Arcadia",
    "websiteUrl": "https://arcadia.workers.dev",
    "privacyUrl": "https://arcadia.workers.dev/privacy",
    "termsOfUseUrl": "https://arcadia.workers.dev/terms"
  },
  "name": {
    "short": "Arcadia",
    "full": "Arcadia — AI Operations Layer"
  },
  "description": {
    "short": "AI-powered intelligence layer for your Teams channels.",
    "full": "Arcadia understands how your teams work. It summarizes threads, surfaces decisions, tracks ownership, detects stalled work, and delivers daily digests — so nothing falls through the cracks."
  },
  "icons": {
    "color": "color.png",
    "outline": "color.png"
  },
  "accentColor": "#1a1a2e",
  "bots": [
    {
      "botId": "REPLACE_WITH_YOUR_TEAMS_APP_ID",
      "scopes": ["team", "personal", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["team", "groupChat"],
          "commands": [
            {
              "title": "Summarize",
              "description": "Summarize the recent activity in this channel"
            },
            {
              "title": "Status",
              "description": "What's going on here? Current project status."
            },
            {
              "title": "Decisions",
              "description": "What decisions have been made?"
            },
            {
              "title": "Next steps",
              "description": "What are the open action items?"
            },
            {
              "title": "Who owns",
              "description": "Who is responsible for a task or area?"
            }
          ]
        },
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "Help",
              "description": "What can Arcadia do?"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["*.workers.dev", "arcadia.workers.dev"]
}
