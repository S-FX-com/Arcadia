# Arcadia v4 — secrets are set with `wrangler secret put <NAME>`, never
# committed. This file documents the names. Vars (non-secret) live in
# wrangler.jsonc.

# Required before Phase 1a first run (CLAUDE.md §9)
WP_APP_PASSWORD=
GRAPH_CLIENT_SECRET=     # Entra app registration secret — sign-in and Graph
SSO_SESSION_SECRET=      # openssl rand -base64 32; rotating it logs everyone out

# Optional — only needed for tasks an admin routes to Claude (§6)
ANTHROPIC_API_KEY=

# Optional
AI_GATEWAY_TOKEN=        # only if the AI Gateway runs in authenticated mode
SERPAPI_KEY=             # enables the SERP check in the research step

# For local dev, put the same names in .dev.vars (gitignored).
