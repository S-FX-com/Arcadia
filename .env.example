# Microsoft Teams (Bot Framework registration)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Microsoft Graph — application (app-only) credentials
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_NOTIFICATION_SECRET=

# Microsoft Graph — webapp delegated (SSO + on-behalf-of)
WEBAPP_CLIENT_ID=
WEBAPP_CLIENT_SECRET=
WEBAPP_SESSION_SECRET=

# Admin
ADMIN_USER_AAD_ID=

# AI providers
ANTHROPIC_API_KEY=
AI_GATEWAY_ID=
# Cloudflare account id — set together with AI_GATEWAY_ID to route Anthropic
# calls through the AI Gateway (cache + observability). If either is unset,
# calls hit api.anthropic.com directly.
CF_ACCOUNT_ID=

# Ops alerting (optional). When set, cron/queue failures POST a compact JSON
# payload here in addition to error-level logs. Fire-and-forget; never blocks.
ALERT_WEBHOOK_URL=

# Agent 365 (optional, set once registered)
AGENT_365_AGENT_ID=

# Public hostname (no scheme) for the Graph change-notification webhook,
# e.g. arcadia.example.com. When unset, ensureSubscriptions is a no-op.
PUBLIC_HOST=
