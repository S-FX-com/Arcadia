# ─────────────────────────────────────────────
# Bot Framework (Azure Bot Service)
# ─────────────────────────────────────────────
# From: Azure Portal → Bot Service → Configuration
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# ─────────────────────────────────────────────
# Microsoft Graph (App Registration)
# ─────────────────────────────────────────────
# From: Azure Portal → App Registrations → your app
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Cloudflare (configured in wrangler.toml — no keys needed here)
# ─────────────────────────────────────────────
# ARCADIA_CACHE  → KV namespace binding
# ARCADIA_DB     → D1 database binding
# AI             → Workers AI binding
